[TEMPLATE]
# ── Credenciales Telegram (OBLIGATORIAS) ───────────────────────────
# Copia este archivo a .env y rellena los valores reales.
# El bot NO arranca sin API_ID, API_HASH y BOT_TOKEN.
API_ID=TU_API_ID
API_HASH=TU_API_HASH
BOT_TOKEN=TU_BOT_TOKEN

# ── Administradores semilla (separados por coma) ───────────────────
# Estos son SUPER-ADMIN permanentes. Otros admins se añaden con /addadmin
ADMIN_ID=123456789

# ── Canales Telegram (opcionales pero recomendados) ────────────────
# Canal donde se LOG todo lo que se sube (auditoría, texto)
# Formato: -1001234567890 (con prefijo -100). 0 = desactivado
LOG_CHANNEL_ID=0

# Canal privado donde se REENVÍAN todos los archivos recibidos por el bot
# (backup sin consumir megas del usuario). 0 = desactivado
STORAGE_CHANNEL_ID=0

# ── Directorios ────────────────────────────────────────────────────
ROOT_DIR=raiz
DATA_DIR=data
LOGS_DIR=logs

# ── Chunking y descargas ───────────────────────────────────────────
CHUNK_SIZE_MB=20
DOWNLOAD_TIMEOUT=600
MAX_DOWNLOAD_ATTEMPTS=5
DOWNLOAD_CHUNK_SIZE=32768

# ── Quotas por usuario ─────────────────────────────────────────────
DEFAULT_USER_QUOTA_MB=1024

# ── BitZero ────────────────────────────────────────────────────────
BITZERO_SIG=@bitzero#2024
BITZERO_HOST=https://bitzero.techdev.cu

# ── Acortador de URLs (URLs cortas) ────────────────────────────────
# Dominio público que apunta al servidor del bot. Ej: https://btz.dwn
# (el shortener corre dentro del bot en SHORTENER_PORT; el dominio
#  debe redirigir/proxy a http://<servidor>:<puerto>)
SHORT_URL_BASE=https://btz.dwn
SHORTENER_HOST=0.0.0.0
SHORTENER_PORT=8080
# TTL en días de los códigos cortos. 0 = sin expiración
SHORT_URL_TTL_DAYS=0

# ── TLS ────────────────────────────────────────────────────────────
# 1 = verificar certificados TLS (requiere certs válidos en las revistas)
# 0 = no verificar (default, revistas cubanas suelen tener self-signed)
TLS_VERIFY=0

# ── TTL estado admin (segundos) ────────────────────────────────────
ADMIN_STATE_TTL_SEC=300

# ── Revistas por defecto (sólo se usan en el primer arranque) ─────
# Rellena usuario/contraseña/submission de cada revista. Si faltan,
# esa revista se omite en el seed.
# KIKI_REV
KIKI_USER=usuario_kiki
KIKI_PASS=password_kiki
KIKI_SUB=3505
KIKI_BITZERO=1
KIKI_KEY=default_key_1

# COMED_REV
COMED_USER=usuario_comed
COMED_PASS=password_comed
COMED_SUB=5577
COMED_BITZERO=1
COMED_KEY=default_key_2

# EMS_REV
EMS_USER=usuario_ems
EMS_PASS=password_ems
EMS_SUB=5191
EMS_BITZERO=1
EMS_KEY=default_key_3

# RUS_REV
RUS_USER=usuario_rus
RUS_PASS=password_rus
RUS_SUB=6200
RUS_BITZERO=1
RUS_KEY=default_key_4

# ── Identidad ──────────────────────────────────────────────────────
DEVELOPER_HANDLE=@TuHandle
